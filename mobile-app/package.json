{
  "name": "EtherAudio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace EtherAudio.xcworkspace -scheme EtherAudio -configuration Release -destination generic/platform=iOS -archivePath EtherAudio.xcarchive archive"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-navigation": "^7.36.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/stack": "^6.3.17",
    "react-native-screens": "^3.25.0",
    "react-native-safe-area-context": "^4.7.2",
    "react-native-gesture-handler": "^2.13.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-svg": "^13.14.0",
    "react-native-elements": "^3.4.3",
    "react-native-vector-icons": "^10.0.0",
    "axios": "^1.5.0",
    "@react-native-async-storage/async-storage": "^1.19.3",
    "react-native-audio-recorder-player": "^3.5.3",
    "react-native-permissions": "^3.9.2",
    "react-native-video": "^5.2.1",
    "react-native-sound": "^0.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.2",
    "@tsconfig/react-native": "^3.0.0",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "jest": "^29.2.1",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "typescript": "^4.8.4"
  },
  "jest": {
    "preset": "react-native"
  }
}