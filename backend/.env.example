# 服务器配置
SERVER_HOST=localhost
SERVER_PORT=8080

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=tingshu
DB_SSL_MODE=disable

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Gemini API 配置
GEMINI_API_KEY=your_gemini_api_key_here

# 开发环境
NODE_ENV=development